# Copy to ../.env (utils/.env) or azure-archive/.env — never commit real values.
# gitignore already covers .env

# --- Azure ---
RG=rg-glacial-media
ACCT=yourstorageacct01
CONTAINER=archive
BLOB_PREFIX=glacial

# Prefer ONE full SAS URL (container-level, with write+create+list; add tier if you set Archive):
# Portal → container → Shared access tokens → generate → "Blob SAS URL"
BLOB_SAS_URL=https://YOURACCT.blob.core.windows.net/archive?sp=racwdli&st=...&se=...&spr=https&sv=...&sr=c&sig=...

# OR split form (script accepts either):
# BLOB_URL=https://YOURACCT.blob.core.windows.net/archive
# BLOB_SAS_TOKEN=sp=racwdli&st=...&se=...&sig=...
# (typo alias BOB_SAS_URL also accepted)

# --- Paths (external volume ONLY for WORKDIR) ---
# Source tree whose *top-level folders* each become one blob
SRC_ROOT=/Volumes/4TB_SCRATCH
# Staging for tar + ledger + logs — must NOT be the boot SSD
WORKDIR=/Volumes/4TB_SCRATCH/glacial-staging
# LEDGER=/Volumes/4TB_SCRATCH/glacial-staging/ledger.tsv

# --- Network lock ---
# Must match the IP allowlisted on the storage account firewall (+ NSG if used)
PUBLIC_IP=203.0.113.10
REQUIRE_PUBLIC_IP_MATCH=true

# --- Behavior ---
SET_ARCHIVE_TIER=true
ZSTD_LEVEL=3
PARALLEL_TAR=1
# REUSE_EXISTING_TAR=true   # or pass --reuse-tar to skip tar when archive already exists
AZCOPY_BUFFER_GB=2
# AZCOPY_CONCURRENCY_VALUE=16

# Optional Slack incoming webhook
# SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Media name hints → plain tar (no zstd). Space-separated.
# MEDIA_HINTS=media video b-roll footage photo audio music MUSIC-TOOLS
